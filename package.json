{
  "name": "dsh-changeproof",
  "version": "0.2.0",
  "description": "ChangeProof - change-relevance + evidence-freshness quality plugin for DeepSeek Harness (DSH)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Apageoflove/DSH-changeproof.git"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/host/cordis-plugin.mjs",
  "exports": {
    ".": "./dist/host/cordis-plugin.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./host": "./dist/host/index.mjs",
    "./cli": "./dist/host/cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.8": "unknown",
        "0.1.1-rc.1": "unknown",
        "0.1.1-rc.2": "unknown"
      }
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/property",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:ui": "vitest run tests/visual tests/accessibility",
    "test:security": "vitest run tests/security",
    "coverage": "vitest run --coverage",
    "seam-probe": "node scripts/seam-probe.ts",
    "benchmark": "node scripts/run-fixture-benchmark.ts",
    "verify-package": "node scripts/verify-package.ts",
    "check-upstream-clean": "node scripts/check-upstream-clean.ts",
    "headless": "node src/host/cli.ts"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "fast-check": "^3.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "types": "./dist/host/plugin.d.mts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "changeproof",
    "变更证明",
    "test-coverage",
    "changed-line-coverage",
    "code-verification",
    "test-impact-analysis",
    "quality-gate",
    "verification",
    "agent-tools",
    "llm-agent",
    "typescript",
    "nodejs",
    "javascript",
    "react",
    "vitest",
    "jest",
    "pytest",
    "coverage"
  ]
}
